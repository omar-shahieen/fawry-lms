# Copy this file to .env and replace the placeholders with local values.
# Keep .env private; it is ignored by git.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lms
SPRING_DATASOURCE_USERNAME=lms_user
SPRING_DATASOURCE_PASSWORD=lms_pass
SPRING_DATASOURCE_DB=lms
SERVER_PORT=8080

# Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D

# Local demo admin account; choose a private password for non-demo use.
ADMIN_SEED_EMAIL=admin@lms.com
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
